{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentTaskReceipt",
  "description": "Immutable receipt issued for every agent task payment in AGENTROPOLIS-PAYRAIL.",
  "type": "object",
  "required": [
    "receiptId",
    "schemaVersion",
    "taskId",
    "agentId",
    "districtId",
    "taskType",
    "amountMinorUnits",
    "currency",
    "status",
    "dryRun",
    "issuedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "receiptId": {
      "type": "string",
      "description": "Globally unique receipt identifier"
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0",
      "description": "Schema version for forward compatibility"
    },
    "taskId": {
      "type": "string",
      "description": "The task this receipt is for"
    },
    "agentId": {
      "type": "string",
      "description": "The agent that performed the task"
    },
    "districtId": {
      "type": "string",
      "description": "The district billed for this task"
    },
    "taskType": {
      "type": "string",
      "description": "Category of task (e.g. 'osint-lookup', 'npc-prompt', 'whale-alert')"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the task performed"
    },
    "currency": {
      "type": "string",
      "const": "USDC",
      "description": "Payment currency (always USDC for MVP)"
    },
    "status": {
      "type": "string",
      "enum": [
        "SIMULATED",
        "PENDING",
        "SETTLED",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ],
      "description": "Canonical settlement status of the payment associated with this receipt"
    },
    "dryRun": {
      "type": "boolean",
      "description": "True if this receipt was generated in dry-run mode (no real funds moved)"
    },
    "settlement": {
      "type": [
        "object",
        "null"
      ],
      "description": "Settlement evidence. txHash is absent for SIMULATED / BLOCKED / FAILED.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "SIMULATED",
            "PENDING",
            "SETTLED",
            "BLOCKED",
            "FAILED"
          ]
        },
        "txHash": {
          "type": "string",
          "description": "On-chain transaction hash. Present only for PENDING / SETTLED."
        },
        "settledAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when settlement was confirmed on-chain."
        }
      },
      "required": [
        "status"
      ]
    },
    "policyId": {
      "type": "string",
      "description": "The wallet-guard policy that approved this payment"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this receipt was created"
    },
    "metadata": {
      "type": "object",
      "description": "Arbitrary key-value metadata attached by the agent or recipe",
      "additionalProperties": true
    },
    "amountMinorUnits": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Canonical 6-decimal ERC-20 USDC minor units encoded as an unsigned integer string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SETTLED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "settlement"
        ],
        "properties": {
          "settlement": {
            "type": "object",
            "required": [
              "status",
              "txHash",
              "settledAt"
            ],
            "properties": {
              "status": {
                "const": "SETTLED"
              },
              "txHash": {
                "type": "string",
                "minLength": 1
              },
              "settledAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "SIMULATED",
              "BLOCKED",
              "FAILED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "settlement": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "not": {
                  "required": [
                    "txHash"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
