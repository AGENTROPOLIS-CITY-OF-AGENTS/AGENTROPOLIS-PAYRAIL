{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentTaskReceipt",
  "description": "Immutable exact-money receipt for AGENTROPOLIS-PAYRAIL.",
  "type": "object",
  "required": [
    "receiptId",
    "schemaVersion",
    "taskId",
    "agentId",
    "districtId",
    "taskType",
    "amountUsdc",
    "currency",
    "status",
    "dryRun",
    "executionMode",
    "issuedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "receiptId": { "type": "string" },
    "schemaVersion": { "type": "string", "const": "1.1.0" },
    "taskId": { "type": "string" },
    "agentId": { "type": "string" },
    "districtId": { "type": "string" },
    "taskType": { "type": "string" },
    "description": { "type": "string" },
    "amountUsdc": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)(?:\\.\\d{1,6})?$",
      "description": "Exact canonical USDC decimal string. Never floating-point."
    },
    "currency": { "type": "string", "const": "USDC" },
    "status": {
      "type": "string",
      "enum": ["dry-run-accepted", "pending-approval", "settled", "failed", "cancelled"]
    },
    "dryRun": { "type": "boolean" },
    "executionMode": {
      "type": "string",
      "enum": ["simulated", "live"]
    },
    "settlementTxHash": { "type": ["string", "null"] },
    "policyId": { "type": "string" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "settledAt": { "type": ["string", "null"], "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
