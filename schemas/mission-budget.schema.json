{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/schemas/mission-budget.schema.json",
  "title": "AGENTROPOLIS Mission Budget",
  "type": "object",
  "additionalProperties": false,
  "required": ["budget_id","mission_id","district_id","requester_agent_id","state","currency","requested_amount","approved_amount","spent_amount","reserved_at","expires_at","idempotency_key","receipt_state"],
  "properties": {
    "budget_id": {"type":"string","minLength":8},
    "mission_id": {"type":"string","minLength":3},
    "district_id": {"type":"string","minLength":2},
    "requester_agent_id": {"type":"string","minLength":3},
    "approver_id": {"type":["string","null"]},
    "mandate_id": {"type":["string","null"]},
    "state": {"type":"string","enum":["requested","estimated","pending_approval","reserved","active","exhausted","released","expired","denied","cancelled","settled","reversed"]},
    "currency": {"type":"string","enum":["OPERATING_CREDIT","USD"]},
    "requested_amount": {"type":"number","minimum":0},
    "approved_amount": {"type":"number","minimum":0},
    "spent_amount": {"type":"number","minimum":0},
    "released_amount": {"type":"number","minimum":0,"default":0},
    "maximum_single_call": {"type":["number","null"],"minimum":0},
    "provider_allowlist": {"type":"array","items":{"type":"string"},"default":[]},
    "capability_allowlist": {"type":"array","items":{"type":"string"},"default":[]},
    "approval_policy": {"type":"string","enum":["auto_under_threshold","human_required","district_approver","blocked"]},
    "data_policy": {"type":"string","enum":["public_only","no_secrets","internal_allowed","restricted"]},
    "receipt_policy": {"type":"string","enum":["required","required_with_provider_usage","required_with_settlement"]},
    "dry_run": {"type":"boolean","default":true},
    "reserved_at": {"type":"string","format":"date-time"},
    "expires_at": {"type":"string","format":"date-time"},
    "settled_at": {"type":["string","null"],"format":"date-time"},
    "idempotency_key": {"type":"string","minLength":8},
    "work_receipt_id": {"type":["string","null"]},
    "receipt_state": {"type":"string","enum":["unsigned_preview","pending_verification","verified","rejected"]},
    "metadata": {"type":"object","additionalProperties":true}
  }
}